@startuml
skinparam classAttributeIconSize 0
class Arr {
  - data : string*
  - size : int
  - capacity : int
  + arr_insert_tail(val : string) : void
  + arr_insert_idx(val : string, idx : int) : void
  + arr_search(idx : int) : string
  + arr_resize(newcap : int) : void
}
class UList {
  - head : Node*
  - sz : int
  + ul_insert_head(val : string) : void
  + ul_insert_tail(val : string) : void
  + ul_search(key : string) : string
}
class DList {
  - head : SNode*
  - tail : SNode*
  - sz : int
  + dl_insert_head(val : string) : void
  + dl_insert_tail(val : string) : void
  + dl_search(key : string) : string
}
class Stack {
  - top : STNode*
  - sz : int
  + st_push(val : string) : void
  + st_pop() : void
}
class Queue {
  - head : QNode*
  - tail : QNode*
  - sz : int
  + q_push(val : string) : void
  + q_pop() : void
}
class AVLTree {
  - root : TNode*
  + t_insert(val : int) : void
  + t_delete(val : int) : void
  + t_search(val : int) : bool
}
class ChainTable {
  - buckets : UList*
  - cap : int
  - sz : int
  + ct_put(key : string, value : string) : void
  + ct_get(key : string, value : string&) : bool
  + ct_remove(key : string) : bool
}
class CuckooTable {
  - t1 : Slot*
  - t2 : Slot*
  - cap : int
  - sz : int
  + cu_put(key : string, value : string) : void
  + cu_get(key : string, value : string&) : bool
  + cu_remove(key : string) : bool
}
ChainTable *-- "many" UList : buckets
@enduml
